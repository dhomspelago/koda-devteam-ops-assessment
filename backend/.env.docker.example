# Copy to .env for Docker Compose (backend/).
# DB_HOST must be the compose service name when PHP runs inside the app container.

APP_NAME="Koda Devteam Ops Assessment"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=koda
DB_USERNAME=koda
DB_PASSWORD=secret

APP_PORT=8000
FORWARD_DB_PORT=3306
RUN_MIGRATIONS=true

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log
