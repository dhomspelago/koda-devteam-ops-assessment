                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Project created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Project created."
                                        },
                                        "data": {
                                            "properties": {
                                                "project": {
                                                    "$ref": "#/components/schemas/Project"
