        "/api/v1/projects": {
            "get": {
                "tags": [
                    "Projects"
                ],
                "summary": "List projects",
                "description": "Returns a paginated list of projects with optional search, status/priority filters, and sorting.",
                "operationId": "ee25bd9b380bcb6f6e87166ac940d4b8",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Partial match on client_name, project_name, or description",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "acme"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Filter by project status",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "In Progress",
                            "enum": [
                                "Planning",
                                "In Progress",
                                "On Hold",
                                "Completed"
                            ]
                        }
                    },
                    {
                        "name": "priority",
                        "in": "query",
                        "description": "Filter by project priority",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "High",
                            "enum": [
                                "Low",
                                "Medium",
                                "High"
                            ]
                        }
                    },
                    {
                        "name": "sort_by",
                        "in": "query",
                        "description": "Column to sort by",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "due_date",
                            "enum": [
                                "id",
                                "client_name",
                                "project_name",
                                "status",
                                "priority",
                                "start_date",
                                "due_date",
                                "created_at"
                            ]
                        }
                    },
                    {
                        "name": "sort_dir",
                        "in": "query",
                        "description": "Sort direction",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "asc",
                            "enum": [
                                "asc",
                                "desc"
                            ]
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Items per page (default 15, max 100)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 15,
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Projects retrieved",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Projects retrieved."
                                        },
                                        "data": {
                                            "properties": {
                                                "projects": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Project"
                                                    }
                                                },
                                                "meta": {
                                                    "properties": {
                                                        "current_page": {
                                                            "type": "integer",
                                                            "example": 1
                                                        },
                                                        "last_page": {
                                                            "type": "integer",
                                                            "example": 2
                                                        },
                                                        "per_page": {
                                                            "type": "integer",
                                                            "example": 15
                                                        },
                                                        "total": {
                                                            "type": "integer",
                                                            "example": 20
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "links": {
                                                    "properties": {
                                                        "first": {
                                                            "type": "string",
                                                            "nullable": true
                                                        },
                                                        "last": {
                                                            "type": "string",
                                                            "nullable": true
                                                        },
                                                        "prev": {
                                                            "type": "string",
                                                            "nullable": true
                                                        },
                                                        "next": {
                                                            "type": "string",
                                                            "nullable": true
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
